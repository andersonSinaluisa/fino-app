{
  "expo": {
    "name": "Fino",
    "slug": "fino",
    "version": "0.1.3",
    "orientation": "portrait",
    "scheme": "fino",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.fino.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Fino solo accede a tu fototeca si eliges desde ahí una factura para registrar un gasto o un archivo para importar un estado de cuenta. Fino no explora tus fotos ni las envía a ningún servidor.",
        "NSCameraUsageDescription": "Fino necesita acceso a la cámara para escanear tus facturas. La foto se lee en tu propio teléfono y no se envía a ningún servidor."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.fino.mobile"
        ]
      }
    },
    "android": {
      "package": "app.fino.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1D1D1B"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Fino necesita acceso al micrófono para registrar movimientos por voz. No se guarda el audio.",
          "speechRecognitionPermission": "Fino usa el reconocimiento de voz de tu teléfono para convertir lo que dices en un movimiento. No se guarda el audio.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withShareIntent.js",
      "./plugins/withQuickEntryShortcut.js",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DineroDisponible",
              "label": "Fino: Dinero disponible",
              "description": "Cuánto puedes gastar ahora mismo.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SaldoTotal",
              "label": "Fino: Saldo total",
              "description": "La suma de todas tus cuentas.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ProximoPago",
              "label": "Fino: Próximo pago",
              "description": "El pago recurrente más reciente que Fino detectó.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "GastosDelMes",
              "label": "Fino: Gastos del mes",
              "description": "Cuánto llevas gastado este mes.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Presupuesto",
              "label": "Fino: Presupuesto",
              "description": "Lo gastado este mes en una categoría que elijas.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Proyeccion",
              "label": "Fino: Proyección",
              "description": "Saldo estimado a fin de mes.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Cuenta",
              "label": "Fino: Cuenta",
              "description": "El saldo de una cuenta que elijas.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Pulso",
              "label": "Fino: Pulso",
              "description": "Lo más relevante que Fino ha notado en tus finanzas.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RegistrarEfectivo",
              "label": "Fino: Registrar efectivo",
              "description": "Anota un gasto en efectivo sin abrir Fino entera.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5080",
      "router": {},
      "eas": {
        "projectId": "50de163e-d814-4e8f-8105-8463c2c26cda",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.fino.mobile.widget",
                  "targetName": "FinoWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.fino.mobile"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.fino.mobile.share",
                  "targetName": "FinoShare",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.fino.mobile"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
