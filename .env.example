# ---------------------------------------------------------------------------
# Nexo - local environment
# Copy to .env and adjust. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker compose and by the API) --------------------
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo_local_dev
POSTGRES_PORT=5432

ConnectionStrings__Default=Host=localhost;Port=5432;Database=nexo;Username=nexo;Password=nexo_local_dev

# --- API -------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080

# Minimum 32 characters. Generate one with:  openssl rand -base64 48
Nexo__Jwt__SigningKey=change-me-to-a-long-random-value-of-at-least-32-chars
Nexo__Jwt__Issuer=nexo-api
Nexo__Jwt__Audience=nexo-mobile

# Base64 of exactly 32 bytes. Generate one with:  openssl rand -base64 32
# Encrypts third-party secrets (OAuth tokens) and salts the audit-log IP hashes.
Nexo__Secrets__EncryptionKey=bmV4by1kZXZlbG9wbWVudC1vbmx5LWtleS0zMmJ5dGU=

# Development-only demo data (user "Anderson" with four accounts).
Nexo__Seed__Demo=true

# Rate limiting. Only ever false in an automated test environment.
Nexo__RateLimiting__Enabled=true

# Push notifications through Expo. Off by default so nothing leaves your machine.
Nexo__Push__Enabled=false

# --- Email ingestion (phase 2) ---------------------------------------------
# Leave empty and the app reports the integration as unavailable instead of
# offering a connect button that cannot work. Never invent credentials.
Nexo__EmailIngestion__Gmail__ClientId=
Nexo__EmailIngestion__Gmail__ClientSecret=
Nexo__EmailIngestion__Gmail__RedirectUri=
Nexo__EmailIngestion__Outlook__ClientId=
Nexo__EmailIngestion__Outlook__ClientSecret=
Nexo__EmailIngestion__Outlook__RedirectUri=
Nexo__EmailIngestion__Forwarding__InboundDomain=
Nexo__EmailIngestion__Forwarding__WebhookSecret=

# --- Mobile ----------------------------------------------------------------
# Android emulator reaches the host at 10.0.2.2; a physical device needs your
# machine's LAN IP (e.g. http://192.168.1.20:5080).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080
