# ---------------------------------------------------------------------------
# Nexo / Fino - production environment template
# Copy to .env.production on the host or map these values from your secret
# manager. Never commit a filled-in production env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
# Prefer a managed PostgreSQL instance with TLS and provider-level backups.
POSTGRES_DB=fino_app
POSTGRES_USER=fino_app
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Used by the API. Keep SSL required unless your provider terminates it through
# a private network that you explicitly trust.
ConnectionStrings__Default=Host=CHANGE_ME_POSTGRES_HOST;Port=5432;Database=fino_app;Username=fino_app;Password=CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD;SSL Mode=Require;Trust Server Certificate=false

# --- API -------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Minimum 32 characters. Generate one with: openssl rand -base64 48
Nexo__Jwt__SigningKey=CHANGE_ME_PRODUCTION_JWT_SIGNING_KEY_AT_LEAST_32_CHARS
Nexo__Jwt__Issuer=nexo-api
Nexo__Jwt__Audience=nexo-mobile

# Base64 of exactly 32 bytes. Generate one with: openssl rand -base64 32
Nexo__Secrets__EncryptionKey=CHANGE_ME_BASE64_32_BYTES

# In production, apply migrations as a deployment step before starting the API.
Nexo__Database__AutoMigrate=false
Nexo__Seed__Demo=false
Nexo__Workers__Enabled=true
Nexo__RateLimiting__Enabled=true
Nexo__Push__Enabled=true

# Native mobile clients do not need CORS. Add only browser origins if a web app
# exists; leaving this empty fails closed outside Development.
Nexo__Cors__AllowedOrigins__0=

# --- Email ingestion --------------------------------------------------------
# Gmail/Outlook remain unavailable until real OAuth credentials exist.
Nexo__EmailIngestion__Gmail__ClientId=
Nexo__EmailIngestion__Gmail__ClientSecret=
Nexo__EmailIngestion__Gmail__RedirectUri=https://api.fino.app/oauth/gmail/callback
Nexo__EmailIngestion__Outlook__ClientId=
Nexo__EmailIngestion__Outlook__ClientSecret=
Nexo__EmailIngestion__Outlook__RedirectUri=https://api.fino.app/oauth/outlook/callback

# Forwarding does not need OAuth, but it does need a real inbound domain and a
# shared webhook secret configured in the relay.
Nexo__EmailIngestion__Forwarding__InboundDomain=in.fino.app
Nexo__EmailIngestion__Forwarding__WebhookSecret=CHANGE_ME_PRODUCTION_FORWARDING_WEBHOOK_SECRET

# --- Mobile / EAS -----------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.fino.app
