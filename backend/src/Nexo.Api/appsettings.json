{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Nexo": {
    "Database": {
      "AutoMigrate": true
    },
    "Jwt": {
      "Issuer": "nexo-api",
      "Audience": "nexo-mobile",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "Auth": {
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "MinimumPasswordLength": 10,
      "AllowSelfRegistration": true
    },
    "Secrets": {
      "EncryptionKey": ""
    },
    "Reminders": {
      "ManualRunEnabled": false
    },
    "Legal": {
      "ControllerName": "",
      "ControllerId": "",
      "ControllerAddress": "",
      "ContactEmail": "info@brix-dev.com",
      "DataProtectionOfficer": "",
      "HostingProvider": "",
      "TermsVersion": "2026-10-02",
      "PrivacyVersion": "2026-10-02",
      "AccountDeletionGraceDays": 7
    },
    "Imports": {
      "MaxFileSizeBytes": 10485760,
      "MaxRows": 20000,
      "AllowedExtensions": [
        ".csv",
        ".xlsx",
        ".txt",
        ".xls"
      ]
    },
    "Deduplication": {
      "DateWindowDays": 3,
      "AmountTolerance": 0.02,
      "ProbableThreshold": 0.72,
      "MinimumDescriptionSimilarity": 0.3
    },
    "Workers": {
      "Enabled": true,
      "InsightRefreshHours": 6,
      "AccountDeletionGraceDays": 7
    },
    "RateLimiting": {
      "Enabled": true
    },
    "Push": {
      "Enabled": true
    },
    "Seed": {
      "Demo": false
    },
    "EmailIngestion": {
      "Gmail": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": ""
      },
      "Outlook": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": ""
      },
      "Forwarding": {
        "InboundDomain": "",
        "WebhookSecret": ""
      }
    },
    "Cors": {
      "AllowedOrigins": []
    }
  }
}
