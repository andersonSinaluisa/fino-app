# ---------------------------------------------------------------------------
# Nexo - staging environment template
# Copy to .env.staging and fill the CHANGE_ME values in your secret manager or
# on the host. Do not commit a filled-in .env.staging.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=nexo_staging
POSTGRES_USER=nexo
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Used when running dotnet/EF tools outside docker compose.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=nexo_staging;Username=nexo;Password=CHANGE_ME_STAGING_POSTGRES_PASSWORD;SSL Mode=Require;Trust Server Certificate=false

# --- API -------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://0.0.0.0:8080

# Minimum 32 characters. Generate one with: openssl rand -base64 48
Nexo__Jwt__SigningKey=CHANGE_ME_STAGING_JWT_SIGNING_KEY_AT_LEAST_32_CHARS
Nexo__Jwt__Issuer=nexo-api
Nexo__Jwt__Audience=nexo-mobile

# Base64 of exactly 32 bytes. Generate one with: openssl rand -base64 32
Nexo__Secrets__EncryptionKey=CHANGE_ME_BASE64_32_BYTES

# This repo does not commit EF migrations yet. Keep this true for the first
# staging deployment so the API creates/applies the schema before seeding
# reference data. Switch to false once migrations are versioned and applied by
# the deployment pipeline.
Nexo__Database__AutoMigrate=true
Nexo__Seed__Demo=false
Nexo__Workers__Enabled=true
Nexo__RateLimiting__Enabled=true
Nexo__Push__Enabled=false

# Outside Development, CORS fails closed unless an origin is listed.
# Add only the web origin if/when there is a web client.
Nexo__Cors__AllowedOrigins__0=https://staging.nexo.app

# --- Email ingestion --------------------------------------------------------
# Gmail/Outlook remain unavailable until real OAuth credentials exist.
# Keep these empty unless they come from Google Cloud Console / Microsoft Entra.
Nexo__EmailIngestion__Gmail__ClientId=
Nexo__EmailIngestion__Gmail__ClientSecret=
Nexo__EmailIngestion__Gmail__RedirectUri=https://api.staging.nexo.app/oauth/gmail/callback
Nexo__EmailIngestion__Outlook__ClientId=
Nexo__EmailIngestion__Outlook__ClientSecret=
Nexo__EmailIngestion__Outlook__RedirectUri=https://api.staging.nexo.app/oauth/outlook/callback

# Forwarding does not need OAuth, but it does need a real inbound domain and a
# shared webhook secret configured in the relay.
Nexo__EmailIngestion__Forwarding__InboundDomain=in.staging.nexo.app
Nexo__EmailIngestion__Forwarding__WebhookSecret=

# --- Mobile / EAS -----------------------------------------------------------
# Use this value in mobile/eas.json preview once the staging API exists.
EXPO_PUBLIC_API_URL=https://api.staging.nexo.app
